#!/bin/bash
# cf-md: Cloudflare Browser Rendering の /markdown API で URL を Markdown にして stdout へ出す
#
# Usage: cf-md <URL>
#
# 認証情報は次の優先順で取得する:
#   1. 環境変数 CLOUDFLARE_BR_API_TOKEN / CLOUDFLARE_BR_ACCOUNT_ID
#   2. ${XDG_CONFIG_HOME:-$HOME/.config}/cf-md/env (chmod 600 推奨)
#   3. 1Password CLI (op read)
# トークンは argv やログに出さない（curl へは -K - で stdin から渡す）。
# 連続呼び出し時は前回実行から最低 10 秒空ける。
set -euo pipefail

readonly OP_ITEM="op://Personal/Cloudflare Browser Rendering"
readonly ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/cf-md/env"
readonly MIN_INTERVAL=10
readonly RATE_LIMIT_WAIT=11

die() {
  echo "cf-md: $*" >&2
  exit 1
}

if [[ $# -ne 1 || -z "$1" || "$1" == "-h" || "$1" == "--help" ]]; then
  echo "usage: cf-md <URL>" >&2
  exit 2
fi
url="$1"

for cmd in curl jq; do
  command -v "$cmd" >/dev/null 2>&1 || die "$cmd not found"
done

# ENV_FILE から未設定の認証変数だけ安全に読む（source せず KEY=VALUE のみ解析）
load_env_file() {
  [[ -f "$ENV_FILE" && -r "$ENV_FILE" ]] || return 0
  local line key val
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    line="${line#export }"
    [[ "$line" == *=* ]] || continue
    key="${line%%=*}"
    val="${line#*=}"
    key="${key#"${key%%[![:space:]]*}"}"
    key="${key%"${key##*[![:space:]]}"}"
    if [[ ${#val} -ge 2 ]]; then
      if [[ "${val:0:1}" == "'" && "${val:${#val}-1:1}" == "'" ]]; then
        val="${val:1:${#val}-2}"
      elif [[ "${val:0:1}" == '"' && "${val:${#val}-1:1}" == '"' ]]; then
        val="${val:1:${#val}-2}"
      fi
    fi
    case "$key" in
      CLOUDFLARE_BR_API_TOKEN)
        [[ -n "${CLOUDFLARE_BR_API_TOKEN:-}" ]] || CLOUDFLARE_BR_API_TOKEN="$val"
        ;;
      CLOUDFLARE_BR_ACCOUNT_ID)
        [[ -n "${CLOUDFLARE_BR_ACCOUNT_ID:-}" ]] || CLOUDFLARE_BR_ACCOUNT_ID="$val"
        ;;
    esac
  done < "$ENV_FILE"
}

load_env_file

# 環境変数・ENV_FILE が空なら 1Password から読む（エラー出力は捨てて短いメッセージだけ出す）
read_secret() {
  local env_value="$1" field="$2"
  if [[ -n "$env_value" ]]; then
    printf '%s' "$env_value"
    return
  fi
  command -v op >/dev/null 2>&1 || die "op not found and credentials not set in env or $ENV_FILE"
  op read "$OP_ITEM/$field" 2>/dev/null || die "failed to read $field from 1Password"
}

token="$(read_secret "${CLOUDFLARE_BR_API_TOKEN:-}" credential)"
account="$(read_secret "${CLOUDFLARE_BR_ACCOUNT_ID:-}" account_id)"
[[ -n "$token" ]] || die "empty API token"
[[ -n "$account" ]] || die "empty account ID"

endpoint="https://api.cloudflare.com/client/v4/accounts/$account/browser-rendering/markdown"
body="$(jq -nc --arg url "$url" '{url: $url}')"

tmp="$(mktemp "${TMPDIR:-/tmp}/cf-md.XXXXXX")"
trap 'command rm -f "$tmp"' EXIT

last_file="${TMPDIR:-/tmp}/cf-md-${UID}.last"

throttle() {
  [[ -r "$last_file" ]] || return 0
  local last now elapsed wait_sec
  last="$(cat "$last_file" 2>/dev/null || true)"
  [[ "$last" =~ ^[0-9]+$ ]] || return 0
  now="$(date +%s)"
  elapsed=$((now - last))
  if (( elapsed >= 0 && elapsed < MIN_INTERVAL )); then
    wait_sec=$((MIN_INTERVAL - elapsed))
    echo "cf-md: waiting ${wait_sec}s to respect rate limit" >&2
    sleep "$wait_sec"
  fi
}

mark_last() {
  date +%s > "$last_file" 2>/dev/null || true
}

# HTTP ステータスを返す。レスポンス本文は $tmp に書く
request() {
  local code
  code="$(
    printf 'header = "Authorization: Bearer %s"\n' "$token" |
      curl -sS -K - \
        --max-time 120 \
        -X POST "$endpoint" \
        -H "Content-Type: application/json" \
        --data-binary "$body" \
        -o "$tmp" \
        -w '%{http_code}'
  )" || die "request failed"
  mark_last
  printf '%s' "$code"
}

throttle
status="$(request)"
if [[ "$status" == "429" ]]; then
  echo "cf-md: rate limited (429), retrying in ${RATE_LIMIT_WAIT}s" >&2
  sleep "$RATE_LIMIT_WAIT"
  status="$(request)"
fi

if [[ "$status" == "200" ]] && jq -e '.success == true and (.result | type == "string")' "$tmp" >/dev/null 2>&1; then
  jq -r '.result' "$tmp"
  exit 0
fi

msg="$(jq -r '[.errors[]?.message] | join("; ")' "$tmp" 2>/dev/null || true)"
die "HTTP $status${msg:+: $msg}"
